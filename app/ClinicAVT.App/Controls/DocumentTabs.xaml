<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Controls.DocumentTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Only the selected view shows. The others stay collapsed and keep their state -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A baseline runs from the first tab's underline to a short tail past the last tab,
             with the selected underline on it. Both sit 4 up because the bar pads its items by 4 below -->
        <Grid x:Name="TabRow" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Bar" SelectionChanged="OnSelectionChanged">
                <SelectorBar.Resources>
                    <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="Transparent" />
                </SelectorBar.Resources>
            </SelectorBar>
            <Border
                Grid.ColumnSpan="2"
                Height="1"
                Margin="8,0,0,4"
                VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                IsHitTestVisible="False" />
            <Border
                x:Name="Underline"
                Grid.ColumnSpan="2"
                Height="2"
                Margin="0,0,0,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="UnderlineShift" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <Grid x:Name="Host" Grid.Row="1" />
    </Grid>
</UserControl>
