<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Controls.StaleNotice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    IsTabStop="False">

    <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon
            FontSize="{StaticResource CaptionTextBlockFontSize}"
            Foreground="{ThemeResource CautionBrush}"
            Glyph="&#xE7BA;" />
        <TextBlock
            Foreground="{ThemeResource CautionBrush}"
            Style="{StaticResource MicroText}"
            Text="{x:Bind Text, Mode=OneWay}" />
        <HyperlinkButton
            AutomationProperties.Name="{x:Bind ActionText, Mode=OneWay}"
            Command="{x:Bind Command, Mode=OneWay}"
            Style="{StaticResource CaptionLink}">
            <controls:IconLabel Style="{StaticResource LinkIconLabel}" Glyph="&#xE72C;" Text="{x:Bind ActionText, Mode=OneWay}" />
        </HyperlinkButton>
    </StackPanel>
</UserControl>
