<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Consultation.ConsultationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Consultation">
            <controls:PageHeader.Centre>
                <!-- Developer replay controls -->
                <ContentControl x:Name="DemoTrayHost" Visibility="{x:Bind DemoTray.Visible, Mode=OneWay}" />
            </controls:PageHeader.Centre>
            <controls:PageHeader.Commands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- The microphone is set once, so it sits with the page commands -->
                    <DropDownButton
                        AutomationProperties.Name="{x:Bind Mic.Label, Mode=OneWay}"
                        IsEnabled="{x:Bind Controls.MicPickerEnabled, Mode=OneWay}"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="{x:Bind Controls.MicTip, Mode=OneWay}"
                        Visibility="{x:Bind Controls.MicPickerVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE720;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="{x:Bind Mic.Label, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout
                                x:Name="MicFlyout"
                                Opening="OnMicFlyoutOpening"
                                Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        AutomationProperties.Name="New consultation"
                        Command="{x:Bind Controls.NewConsultationCommand}"
                        Visibility="{x:Bind Controls.ReviewVisible, Mode=OneWay}">
                        <controls:IconLabel Glyph="&#xE710;" Text="New consultation" />
                    </Button>
                </StackPanel>
            </controls:PageHeader.Commands>
        </controls:PageHeader>

        <!-- The record control holds this region until stop, then the documents take it -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <!-- The 2* and 3* rows put the record control at the optical centre, two fifths down -->
            <Grid Visibility="{x:Bind Controls.CentreStageVisible, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="1"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    Spacing="20">
                    <ContentControl x:Name="ControlsHost" HorizontalAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Style="{StaticResource BodyText}"
                        Text="Ensure patient consent is given before starting to record the consultation."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Controls.IdleVisible, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <!-- The top margin is the height of the Sessions search row, so the title lines up
                 with the inbox title -->
            <Grid
                Margin="0,44,0,0"
                RowSpacing="20"
                Visibility="{x:Bind Controls.PanesVisible, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <!-- Matches the inbox title's size and weight -->
                <TextBlock
                    MaxWidth="1480"
                    Padding="0,4"
                    HorizontalAlignment="Stretch"
                    FontSize="{StaticResource SubtitleTextBlockFontSize}"
                    FontWeight="SemiBold"
                    Text="{x:Bind Header.Title, Mode=OneWay}" />
                <ContentControl
                    x:Name="SurfaceHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
