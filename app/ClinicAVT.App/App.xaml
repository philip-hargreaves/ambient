<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClinicAVT.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Order matters. Tokens resolve against Palette, and Styles against both -->
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared by the reading pages so they line up -->
            <x:Double x:Key="ReadingColumnWidth">880</x:Double>

            <!-- The stock selection pill is too small to read as a tab -->
            <x:Double x:Key="SelectorBarItemPillWidth">12</x:Double>
            <x:Double x:Key="SelectorBarItemPillHeight">4</x:Double>

            <!-- Every accent shade is pinned so the hover, pressed and per-theme variants
                 WinUI derives all match -->
            <Color x:Key="SystemAccentColor">#0067C0</Color>
            <Color x:Key="SystemAccentColorLight1">#2183D6</Color>
            <Color x:Key="SystemAccentColorLight2">#4F9FE0</Color>
            <Color x:Key="SystemAccentColorLight3">#85BFEC</Color>
            <Color x:Key="SystemAccentColorDark1">#005AA8</Color>
            <Color x:Key="SystemAccentColorDark2">#004C8F</Color>
            <Color x:Key="SystemAccentColorDark3">#003A6E</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
