<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ambient.App.Controls">

    <!-- Style roles derived from WinUI's own styles and theme resources, so
         states, themes and focus visuals come from the platform. No hexes. -->

    <!-- Text roles on the Windows 11 type ramp -->
    <Style x:Key="PaneHeaderText" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Document heading in the stacked review -->
    <Style x:Key="DocumentHeadingText" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The recommendation is the body of a guidance card -->
    <Style x:Key="RecommendationText" TargetType="TextBlock"
           BasedOn="{StaticResource BodyText}">
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MicroText" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FaintTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Mica is level 1, layer fill 2, inner cards 3. Lift comes from the fill
         difference alone -->
    <Style x:Key="CardSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="InnerCardSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Record disc: accent to begin, neutral to stop -->
    <Style x:Key="RecordDisc" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
        <Setter Property="CornerRadius" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StopDisc" TargetType="Button">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
        <Setter Property="CornerRadius" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Tabular figures so the running clock does not jitter -->
    <Style x:Key="ClockText" TargetType="TextBlock"
           BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TrayButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="9,5" />
    </Style>

    <Style x:Key="TrayToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A fold or section toggle drawn as text: no chrome until hovered, flush with the text beside it -->
    <Style x:Key="FoldButton" TargetType="Button" BasedOn="{StaticResource TrayButton}">
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Inline links at caption size, the row of actions under a card -->
    <Style x:Key="CaptionLink" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
    </Style>

    <!-- An editable title: reads as a heading, edits in place -->
    <Style x:Key="TitleTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A document that accepts a caret: card chrome, no box chrome. The
         focus states keep the platform's underline via the template. -->
    <Style x:Key="DocumentTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- One card per settings group, its settings as rows divided by a line -->
    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <!-- A row drawn by hand when the left side is more than a title and a
         description. The first row in a card sets BorderThickness to 0 -->
    <Style x:Key="SettingsRowChrome" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Title and description left, the control right -->
    <Style TargetType="views:SettingsRow">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:SettingsRow">
                    <Grid
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingsDescription}"
                                       Text="{TemplateBinding Description}" />
                        </StackPanel>
                        <ContentPresenter
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="4,20,0,4" />
    </Style>

    <Style x:Key="SettingsDescription" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource FaintTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Chip base. The role's colours apply at the usage site -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
