<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Only colours WinUI does not supply: speakers and status, light values
        from Palette.xaml, dark chosen by hand (the light ones fail WCAG AA
        on dark). Dark is keyed "Default" - that is where WinUI looks it up.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DoctorBrush" Color="{StaticResource SpeakerDoctor}" />
            <SolidColorBrush x:Key="PatientBrush" Color="{StaticResource SpeakerPatient}" />
            <SolidColorBrush x:Key="OnDeviceBrush" Color="{StaticResource StatusSecure}" />
            <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource StatusCaution}" />
            <SolidColorBrush x:Key="OnDeviceSoftBrush" Color="{StaticResource StatusSecureSoft}" />
            <SolidColorBrush x:Key="CautionSoftBrush" Color="{StaticResource StatusCautionSoft}" />
            <SolidColorBrush x:Key="UnknownSpeakerBrush" Color="#707070" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#5A5A5A" />
            <SolidColorBrush x:Key="ReferenceChipBrush" Color="{StaticResource BrandNhs}" />
            <SolidColorBrush x:Key="ReferenceChipSoftBrush" Color="{StaticResource ColorAccentSoft}" />
            <SolidColorBrush x:Key="ReferenceChipBorderBrush" Color="{StaticResource ColorAccentBorder}" />
            <SolidColorBrush x:Key="OnDeviceChipBorderBrush" Color="{StaticResource StatusSecureBorder}" />
            <!-- The page stays white in both themes, so its marks keep one colour -->
            <SolidColorBrush x:Key="PageMarkBrush" Color="#66FFD54F" />
            <SolidColorBrush x:Key="PageSheetBrush" Color="#DDE1E6" />
            <SolidColorBrush x:Key="PageEdgeBrush" Color="#B8BEC6" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DoctorBrush" Color="#4CA0E0" />
            <SolidColorBrush x:Key="PatientBrush" Color="#A98BEA" />
            <SolidColorBrush x:Key="OnDeviceBrush" Color="#3FB56B" />
            <SolidColorBrush x:Key="CautionBrush" Color="#E0913A" />
            <SolidColorBrush x:Key="OnDeviceSoftBrush" Color="#1E3A2A" />
            <SolidColorBrush x:Key="CautionSoftBrush" Color="#43301C" />
            <SolidColorBrush x:Key="UnknownSpeakerBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#C5C5C5" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="#9D9D9D" />
            <SolidColorBrush x:Key="ReferenceChipBrush" Color="#7DB8F0" />
            <SolidColorBrush x:Key="ReferenceChipSoftBrush" Color="#1B2C40" />
            <SolidColorBrush x:Key="ReferenceChipBorderBrush" Color="#2B4666" />
            <SolidColorBrush x:Key="OnDeviceChipBorderBrush" Color="#2E5A40" />
            <SolidColorBrush x:Key="PageMarkBrush" Color="#66FFD54F" />
            <SolidColorBrush x:Key="PageSheetBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="PageEdgeBrush" Color="#4A4A4A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DoctorBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="PatientBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="OnDeviceBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CautionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnDeviceSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CautionSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="UnknownSpeakerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FaintTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ReferenceChipBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ReferenceChipSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ReferenceChipBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnDeviceChipBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PageMarkBrush" Opacity="0.4" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PageSheetBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PageEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
