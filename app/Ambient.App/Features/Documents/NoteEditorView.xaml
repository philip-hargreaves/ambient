<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Features.Documents.NoteEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="0,10,0,8" RowSpacing="10">
        <!-- The note sizes to its text (capped in code where a host bounds
             the editor) and guidance takes what is left, scrolling inside.
             A page that scrolls leaves both to their content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top right produces the document, bottom left takes it away,
             bottom right is the edit lifecycle -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing
                    Width="14"
                    Height="14"
                    IsActive="{x:Bind ViewModel.NotePreparing, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NotePreparing, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="{x:Bind ViewModel.NoteStateCaption, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NoteCaptionVisible, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="{x:Bind ViewModel.EditedStamp, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.Edited, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- A refusal shows its reason and one way past it -->
                <TextBlock
                    Style="{StaticResource MicroText}"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.RefusalReason, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.NoteRefused, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.WriteAnywayCommand}"
                    Content="Write a note anyway"
                    Visibility="{x:Bind ViewModel.CanWriteAnyway, Mode=OneWay}" />
                <!-- Demo records only: a written case stands in as the note -->
                <ComboBox
                    MinWidth="140"
                    MaxWidth="180"
                    AutomationProperties.Name="Example case"
                    ItemsSource="{x:Bind ViewModel.ExampleCaseTitles, Mode=OneWay}"
                    PlaceholderText="Example case"
                    SelectedIndex="{x:Bind ViewModel.ExampleCaseIndex, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.ExampleCasesVisible, Mode=OneWay}" />
                <ComboBox
                    MinWidth="104"
                    AutomationProperties.Name="Note style"
                    DisplayMemberPath="Name"
                    IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.StyleOptions}"
                    SelectedIndex="{x:Bind ViewModel.StyleIndex, Mode=TwoWay}" />
                <ComboBox
                    MinWidth="118"
                    AutomationProperties.Name="Note detail"
                    DisplayMemberPath="Name"
                    IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.DetailOptions}"
                    SelectedIndex="{x:Bind ViewModel.DetailIndex, Mode=TwoWay}" />
                <Button x:Name="RegenerateButton"
                        Command="{x:Bind ViewModel.RegenerateCommand}"
                        ToolTipService.ToolTip="Rewrite the note with the chosen style and detail">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Regenerate" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The clinician's document, editable in place. The minimum keeps
             it a document when short or hosted in an unbounded column -->
        <TextBox
            x:Name="NoteBox"
            Grid.Row="1"
            MinHeight="140"
            IsHitTestVisible="{x:Bind ViewModel.NoteEditing, Mode=OneWay}"
            IsReadOnly="{x:Bind ViewModel.NoteViewing, Mode=OneWay}"
            IsTabStop="{x:Bind ViewModel.NoteEditing, Mode=OneWay}"
            SelectionHighlightColorWhenNotFocused="{ThemeResource AccentFillColorTertiaryBrush}"
            Style="{StaticResource DocumentTextBox}"
            Text="{x:Bind ViewModel.ClinicalNoteText, Mode=TwoWay}" />

        <Grid Grid.Row="2" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind Export.CopyNoteCommand}"
                        IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind Export.ExportNoteCommand}"
                        IsEnabled="{x:Bind ViewModel.NoteDocumentReady, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NoteViewing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                </Button>
                <!-- Disabled when the consultation is not being kept -->
                <Button Command="{x:Bind ViewModel.ReflectCommand}"
                        ToolTipService.ToolTip="An appraisal reflection on this consultation"
                        Visibility="{x:Bind ViewModel.NoteViewing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE70B;" />
                        <TextBlock Text="{x:Bind ViewModel.ReflectLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Read-only until an explicit Edit. Save commits, Discard restores -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.EditNoteCommand}"
                    Visibility="{x:Bind ViewModel.NoteViewing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{x:Bind ViewModel.DiscardNoteCommand}"
                    Content="Discard"
                    Visibility="{x:Bind ViewModel.NoteEditing, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SaveNoteCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.NoteEditing, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="Save note" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ContentControl
            x:Name="GuidanceHost"
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <!-- An edited note is the clinician's wording, so Regenerate asks
             before replacing it -->
        <TeachingTip
            Title="Replace your edits?"
            ActionButtonCommand="{x:Bind ViewModel.ConfirmRegenerateCommand}"
            ActionButtonContent="Regenerate"
            CloseButtonCommand="{x:Bind ViewModel.KeepEditsCommand}"
            CloseButtonContent="Keep my note"
            IsOpen="{x:Bind ViewModel.RegenerateWarningOpen, Mode=TwoWay}"
            PreferredPlacement="Top"
            Subtitle="You changed this note. Regenerating writes a new note from the transcript and your changes are lost."
            Target="{x:Bind RegenerateButton}" />
    </Grid>
</UserControl>
