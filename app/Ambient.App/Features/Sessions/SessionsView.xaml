<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Features.Sessions.SessionsView"
    x:Name="SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ambient.App.Controls"
    xmlns:vm="using:Ambient.App.Core.Features.Sessions">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Sessions">
            <controls:PageHeader.Commands>
                <Button
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource TrayButton}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </controls:PageHeader.Commands>
        </controls:PageHeader>

    <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Sessions}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionRow">
                    <!-- Unlabelled: one line. Labelled: title, then date and length -->
                    <Grid Padding="0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Heading}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind MetaVisible}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource FaintTextBrush}"
                                    Text="{x:Bind Meta}"
                                    Visibility="{x:Bind HasLabel}" />
                                <TextBlock
                                    Style="{StaticResource MicroText}"
                                    Text="{x:Bind EditedLabel}"
                                    Visibility="{x:Bind Edited}" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Delete this consultation"
                            Command="{Binding ElementName=SessionsPage, Path=ViewModel.DeleteCommand}"
                            CommandParameter="{x:Bind}"
                            Style="{StaticResource TrayButton}"
                            ToolTipService.ToolTip="Delete this consultation">
                            <FontIcon FontSize="{StaticResource BodyTextBlockFontSize}" Foreground="{ThemeResource FaintTextBrush}" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- The open consultation: the live view's own renderers in tabs -->
        <Grid
            x:Name="DetailGrid"
            Grid.Row="1"
            Grid.Column="1"
            RowSpacing="20"
            SizeChanged="OnDetailSizeChanged"
            Visibility="{x:Bind ViewModel.DetailOpen, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The title is the label, edited in place. The header shares the documents' column -->
            <Grid
                x:Name="DetailHeader"
                MaxWidth="1480"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="0">
                    <TextBox
                        AutomationProperties.Name="Consultation label"
                        LostFocus="OnTitleCommitted"
                        Style="{StaticResource TitleTextBox}"
                        PlaceholderText="Name this consultation"
                        Text="{x:Bind ViewModel.DetailTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionText}"
                            Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource MicroText}"
                            Text="{x:Bind ViewModel.Note.EditedStamp, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.Note.Edited, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Wide: note and patient sheet beside the transcript. Narrow: tabs. Views move in code -->
            <Grid
                x:Name="WideLayout"
                Grid.Row="1"
                MaxWidth="1480"
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="760" />
                    <ColumnDefinition Width="*" MaxWidth="700" />
                </Grid.ColumnDefinitions>
                <!-- The patient sheet folds. The note does not -->
                <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0" Spacing="6">
                        <TextBlock Style="{StaticResource DocumentHeadingText}" Text="Clinical note" />
                        <ContentControl
                            x:Name="NoteHostWide"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                        <Button
                            Margin="0,16,0,0"
                            Command="{x:Bind ViewModel.TogglePatientFoldCommand}"
                            Style="{StaticResource FoldButton}"
                            ToolTipService.ToolTip="Show or hide the patient information">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Style="{StaticResource DocumentHeadingText}" Text="Patient information" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                                    Foreground="{ThemeResource FaintTextBrush}"
                                    Glyph="{x:Bind ViewModel.PatientFoldGlyph, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <ContentControl
                            x:Name="PatientHostWide"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.PatientVisible, Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
                <!-- Page-height card with the transcript scrolling inside. The page
                     view of an added document takes its place while it is open -->
                <Border
                    x:Name="TranscriptCard"
                    Grid.Column="1"
                    Padding="12,8,12,12"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource InnerCardSurface}">
                    <ContentControl
                        x:Name="TranscriptHostWide"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                </Border>
                <ContentControl
                    x:Name="PageHostWide"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Visibility="Collapsed" />
            </Grid>

            <Grid
                x:Name="NarrowLayout"
                Grid.Row="1"
                MaxWidth="760"
                HorizontalAlignment="Center">
                <TabView
                    x:Name="NarrowTabs"
                    VerticalAlignment="Stretch"
                    CanDragTabs="False"
                    CanReorderTabs="False"
                    IsAddTabButtonVisible="False"
                    TabWidthMode="SizeToContent">
                    <TabView.TabItems>
                        <TabViewItem Header="Clinical note" IsClosable="False">
                            <ContentControl
                                x:Name="NoteHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </TabViewItem>
                        <TabViewItem Header="Patient information" IsClosable="False">
                            <ContentControl
                                x:Name="PatientHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </TabViewItem>
                        <TabViewItem Header="Transcript" IsClosable="False">
                            <ContentControl
                                x:Name="TranscriptHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </TabViewItem>
                        <TabViewItem
                            x:Name="PageTab"
                            Header="Document page"
                            IsClosable="False"
                            Visibility="Collapsed">
                            <ContentControl
                                x:Name="PageHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                        </TabViewItem>
                    </TabView.TabItems>
                </TabView>
            </Grid>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.SelectHintVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PaneHeaderText}"
                Text="Select a consultation" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="Its transcript, note and patient sheet open here." />
        </StackPanel>

        <!-- Keep consultations is off and nothing is stored: the page explains
             why the list is empty -->
        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.EmptyBecauseOff, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="24"
                Foreground="{ThemeResource FaintTextBrush}"
                Glyph="&#xE72E;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PaneHeaderText}"
                Text="Consultations are not being kept" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionText}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Each consultation is erased when you leave it. Turn on Save consultation data in Settings to keep the transcript, note and patient sheet on this device." />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind Shell.ShowSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                    <TextBlock Text="Open Settings" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
    </Grid>
</UserControl>
