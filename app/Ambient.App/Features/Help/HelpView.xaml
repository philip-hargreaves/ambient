<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Features.Help.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ambient.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <!-- The guide and the small print, one topic per card, closed until asked -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="Help" />
        <!-- The reading column: one width, centred by the two gutters -->
        <ScrollViewer Grid.Row="1">
            <Grid Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Takes the width until the cap, then the gutters share what is left -->
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadingColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Spacing="4">

                <TextBlock
                    Margin="4,4,0,4"
                    Style="{StaticResource SettingsGroupHeader}"
                    Text="Using Ambient" />

                <toolkit:SettingsExpander Description="Consent, and what the app does with the audio" Header="Before you start">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Ask everyone in the room before you record, including an interpreter on the phone. A sentence is enough: the consultation is transcribed by software to help write the notes, and nothing leaves this computer." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Start the consultation after the patient has given their name and date of birth, so the transcript carries neither." />
                                <TextBlock Style="{StaticResource HelpText}" Text="The audio is used to write the transcript and is then discarded. It is never kept." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="Start, stop, and what happens next" Header="Recording">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Press the microphone button on the Consultation page. The microphone named at the top right is the one in use; pick another there if you need to." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Press Stop when the consultation ends. The transcript is finished first, then the clinical note is written, then the patient information sheet. Nothing shows until the transcript is complete." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Voices are told apart automatically. The doctor and the patient are labelled; anyone else is labelled as another speaker, and what they say still counts towards the note." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="Note styles, editing, regenerate, copy and export" Header="Reviewing the note">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Every document is a draft. Read it against what was said and change what is wrong: press Edit, make your changes, then Save note." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Note style sets the shape of the note, prose or SOAP, and how much detail it carries. Changing either and pressing Regenerate writes the note again from the transcript, so do that before you edit, not after." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Copy puts the note on the clipboard as plain text, ready to paste into the patient record. Export saves it as a text file." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Guidelines beside the note are passages from your guideline documents that match its wording. They are there to check against, and nothing from them is written into the note." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="The sheet for the patient, and its translation" Header="Patient information">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="The patient information sheet explains the consultation in plain English: what was found, what the plan is, and when to get in touch. Edit it the same way as the note." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Pick a language and press Translate to add a translation under the English. Copy takes both, so the patient leaves with the sheet in their own language and the record shows what they were given." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Translation is automatic and can make mistakes. Where the wording matters, check it with the interpreter." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="Where they live, and how to add or remove one" Header="Guideline documents">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Guideline documents are PDF, text or Markdown files in a folder inside your Documents. Settings, Guideline documents shows the folder, and Add documents copies files into it. Remove takes one out; removing a file from the folder does the same." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Each document is read once and searched on this computer after every note. A scanned PDF with no text cannot be searched and says so in the list." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Do not add anything that identifies a patient." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="Finding, renaming and deleting stored consultations" Header="Sessions">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Sessions lists every consultation kept on this computer, newest first, with its transcript, note and patient sheet. Search finds a consultation by its label or its words." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Click the label above a consultation to rename it. Delete on a row removes that consultation; Delete all in Settings removes every one and cannot be undone." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Consultations are stored encrypted, on this computer only, under your Windows account. Turn off Save consultation data in Settings and each one is erased when you leave it." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander Description="Reflections for your appraisal" Header="Appraisal">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HelpText}" Text="Create reflection on a clinical note starts a reflection for that consultation. The case is summarised without identifying details, and you answer what stood out, what you learned and whether you would do anything differently. The guidance the consultation drew on is listed with a tick box each, so you can record which guideline or document you looked up." />
                                <TextBlock Style="{StaticResource HelpText}" Text="Reflections gather on the Appraisal page by month. Copy takes one as plain text for your appraisal portfolio." />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsCard Description="Ambient follows the text size in Windows Settings, Accessibility, Text size. Change it there and the app resizes as you do." Header="Larger text" />

                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="About" />
                <toolkit:SettingsExpander Description="{x:Bind ViewModel.VersionLine}" Header="Ambient">
                    <!-- Partner marks, listed in Assets/logos/credits.json -->
                    <StackPanel
                        x:Name="AboutMarks"
                        Orientation="Horizontal"
                        Spacing="16" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Header="What it does">
                            <toolkit:SettingsCard.Description>
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Text="Ambient produces a draft transcript, clinical note and patient information sheet from a consultation. The patient sheet can also be translated into the patient's own language. Every document is a draft for a clinician to review and edit - nothing is final until a clinician has checked it." />
                                    <TextBlock TextWrapping="Wrap" Text="This app is a demonstrative product, developed by Philip Hargreaves in collaboration with Intel and the NHS. It is for demonstration and evaluation only, and is not for use in real clinical settings." />
                                </StackPanel>
                            </toolkit:SettingsCard.Description>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Disclaimer">
                            <toolkit:SettingsCard.Description>
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Text="&#x2022;  Ambient does not diagnose, recommend treatment or add clinical information of its own. It is not a medical device." />
                                    <TextBlock TextWrapping="Wrap" Text="&#x2022;  Automatic transcription, drafting and translation make mistakes - missed words, wrong speaker labels, wording that changes meaning. Ambient is built on the principle that a clinician checks every document against what was actually said." />
                                    <TextBlock TextWrapping="Wrap" Text="&#x2022;  Nothing Ambient produces is a substitute for clinical judgement; responsibility for any clinical record always rests with a clinician." />
                                    <TextBlock TextWrapping="Wrap" Text="&#x2022;  Guidelines shown beside a note are matched to it by wording and are there for review. Nothing from them enters the note." />
                                </StackPanel>
                            </toolkit:SettingsCard.Description>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Privacy">
                            <toolkit:SettingsCard.Description>
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Text="Everything runs on device. Audio, transcripts, notes and translations are processed and stored locally; nothing leaves the device." />
                                    <TextBlock TextWrapping="Wrap" Text="Guideline documents you add are kept in a folder in your Documents and searched on this device. The app reads them where they are and sends nothing anywhere." />
                                </StackPanel>
                            </toolkit:SettingsCard.Description>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="PDFs are read with PDFium (The PDFium Authors, BSD 3-Clause licence) from the pdfium-binaries build (Benoit Blanchon, MIT licence). The licence texts sit in the licences folder beside the app." Header="Third-party software" />
                        <toolkit:SettingsCard Header="Minimum system requirements">
                            <toolkit:SettingsCard.Description>
                                <StackPanel Spacing="6">
                                    <TextBlock TextWrapping="Wrap" Text="&#x2022;  Windows 11, 64-bit&#x0a;&#x2022;  Intel Core Ultra Series 2 processor with Intel Arc iGPU&#x0a;&#x2022;  16 GB RAM&#x0a;&#x2022;  20 GB free disk space, for the models and their compiled caches" />
                                    <TextBlock TextWrapping="Wrap" Text="Developed and tested on an Intel Core Ultra 9 285H with Intel Arc 140T graphics and 64 GB RAM." />
                                </StackPanel>
                            </toolkit:SettingsCard.Description>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
