<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Features.Consultation.ConsultationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ambient.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Consultation">
            <controls:PageHeader.Centre>
                <!-- Replay controls, a developer tool, on the page's centre line -->
                <ContentControl x:Name="DemoTrayHost" Visibility="Collapsed" />
            </controls:PageHeader.Centre>
            <controls:PageHeader.Commands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind Controls.NewConsultationCommand}"
                        Visibility="{x:Bind Controls.ReviewVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New consultation" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:PageHeader.Commands>
        </controls:PageHeader>

        <!-- One region, two occupants: the record control while idle or
             recording, the documents from the stop onward -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <!-- The record control with the microphone as its caption -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4"
                Visibility="{x:Bind Controls.CentreStageVisible, Mode=OneWay}">
                <ContentControl x:Name="ControlsHost" HorizontalAlignment="Center" />
                <DropDownButton
                    HorizontalAlignment="Center"
                    x:Name="MicPicker"
                    IsEnabled="{x:Bind Controls.MicPickerEnabled, Mode=OneWay}"
                    Style="{StaticResource TrayButton}"
                    ToolTipService.ToolTip="{x:Bind Controls.MicTip, Mode=OneWay}"
                    Visibility="{x:Bind Controls.MicPickerVisible, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE720;" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource MutedTextBrush}"
                                   Text="{x:Bind Mic.Label, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="MicFlyout" Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Grid ColumnSpacing="20" Visibility="{x:Bind Controls.PanesVisible, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TranscriptColumn" Width="1.15*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PageColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <!-- No pane containers: the content items are the cards,
                     floating on the layer the way the turns do -->
                <ContentControl
                    x:Name="TranscriptHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <ContentControl
                    x:Name="NoteHost"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <!-- The page view takes the transcript's place while it is open -->
                <ContentControl
                    x:Name="PageHost"
                    Grid.Column="2"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
