<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ambient.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ambient">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Ambient" />

        <!-- Beside the name: demo mode is on, or a demo record is on screen. Laid over the
             bar, since its content slot centres and makes the bar tall; drags pass through -->
        <TextBlock
            Margin="64,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Foreground="{ThemeResource CautionBrush}"
            IsHitTestVisible="False"
            Style="{StaticResource CaptionText}"
            Text="· Demo"
            Visibility="{x:Bind Status.Demo, Mode=OneWay}" />

        <ContentControl
            x:Name="NavHost"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
