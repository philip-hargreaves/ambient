<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One row at the top of every page: the title at the left, the page's commands
         filling the rest. Subtitle weight, so it names the page without shouting -->
    <Grid MinHeight="48" Padding="24,8,24,0" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
            VerticalAlignment="Center"
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}" />
        <ContentPresenter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            Content="{x:Bind Commands, Mode=OneWay}" />
    </Grid>
</UserControl>
