<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One row at the top of every page: the title at the left, anything central on the
         page's centre line, the page's commands at the right. Subtitle weight, so the title
         names the page without shouting -->
    <Grid MinHeight="48" Padding="24,8,24,0" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}" />
        <ContentPresenter
            Grid.Column="1"
            VerticalAlignment="Center"
            Content="{x:Bind Centre, Mode=OneWay}" />
        <ContentPresenter
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="{x:Bind Commands, Mode=OneWay}" />
    </Grid>
</UserControl>
