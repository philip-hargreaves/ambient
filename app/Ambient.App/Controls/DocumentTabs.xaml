<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Controls.DocumentTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Views of one consultation, switched by a selector bar: one shows, the rest keep
         their state out of sight -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="Bar" SelectionChanged="OnSelectionChanged" />
        <Grid x:Name="Host" Grid.Row="1" />
    </Grid>
</UserControl>
