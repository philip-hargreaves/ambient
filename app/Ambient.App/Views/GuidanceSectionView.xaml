<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.GuidanceSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ambient.App.Views"
    xmlns:vm="using:Ambient.App.Core.ViewModels">

    <Grid RowSpacing="8" Visibility="{x:Bind ViewModel.Visible, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The fold the patient sheet uses in the review, the count beside it -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Margin="-9,0,0,-2"
                Padding="9,4"
                HorizontalAlignment="Left"
                Click="OnFoldClick"
                Style="{StaticResource TrayButton}"
                ToolTipService.ToolTip="Nearest recommendations to the note from the installed guidance. It may have no guideline for this condition, so check each title.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource DocumentHeadingText}" Text="Guidelines" />
                    <FontIcon
                        x:Name="FoldGlyph"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource FaintTextBrush}"
                        Glyph="&#xE70E;" />
                </StackPanel>
            </Button>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <!-- The timing fades a few seconds after it lands -->
                <StackPanel
                    x:Name="Timing"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.FoundInVisible, Mode=OneWay}">
                    <TextBlock Style="{StaticResource MicroText}" Text="&#xB7;" />
                    <TextBlock Style="{StaticResource MicroText}" Text="{x:Bind ViewModel.FoundIn, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <!-- Enter or the glyph searches, Escape clears -->
            <AutoSuggestBox
                x:Name="SearchRow"
                Grid.Column="2"
                MinWidth="240"
                AutomationProperties.Name="Search guidance"
                IsEnabled="{x:Bind ViewModel.QueryBoxEnabled, Mode=OneWay}"
                KeyDown="OnQueryKeyDown"
                PlaceholderText="Search guidance"
                QueryIcon="Find"
                QuerySubmitted="OnQuerySubmitted"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
        </Grid>

        <Grid x:Name="Body" Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Optional lines stack. A collapsed grid row would keep its spacing -->
            <StackPanel Spacing="6">
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="These recommendations match the wording of the note. The guideline may be for another condition, so check each title."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.LimitationVisible, Mode=OneWay}" />
                <!-- A typed query stands in for the note's cards until Clear -->
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.QueryShown, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionText}"
                        Text="{x:Bind ViewModel.QueryHeader, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.QuerySearching, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.QuerySearching, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource MicroText}"
                        Text="{x:Bind ViewModel.QueryCaption, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.QueryCaptionVisible, Mode=OneWay}" />
                    <HyperlinkButton
                        Grid.Column="3"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ClearQueryCommand}"
                        Content="Clear"
                        FontSize="12" />
                </Grid>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.CaptionVisible, Mode=OneWay}">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.Searching, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Searching, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource MicroText}"
                        Text="{x:Bind ViewModel.StateCaption, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchNoteCommand}"
                        Content="Search again"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchNoteCommand}"
                        Content="Search"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.NotSearched, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind Shell.ShowSettingsCommand}"
                        Content="Open Settings"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.SettingsLinkVisible, Mode=OneWay}" />
                </StackPanel>
                <!-- The stale row the patient sheet uses -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.SearchAgainVisible, Mode=OneWay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource CautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Foreground="{ThemeResource CautionBrush}"
                        Style="{StaticResource MicroText}"
                        Text="{x:Bind ViewModel.StaleCaption, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchNoteCommand}"
                        FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock FontSize="12" Text="Search again" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource CautionBrush}"
                    Style="{StaticResource MicroText}"
                    Text="Not saved with this consultation."
                    Visibility="{x:Bind ViewModel.NotStored, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.CardsVisible, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuidanceCard">
                            <StackPanel>
                                <!-- A hairline with the source's name where the added documents end -->
                                <Grid
                                    Margin="0,2,0,10"
                                    ColumnSpacing="10"
                                    Visibility="{x:Bind DividerVisible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource MicroText}"
                                        Text="{x:Bind Divider}" />
                                    <Rectangle
                                        Grid.Column="2"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                </Grid>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,14,16,10"
                                    Style="{StaticResource InnerCardSurface}">
                                    <StackPanel>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource MicroText}" Text="{x:Bind Meta}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Background="{x:Bind views:ChipBrushes.Fill(Source)}"
                                                BorderBrush="{x:Bind views:ChipBrushes.Stroke(Source)}"
                                                Style="{StaticResource ChipBorder}">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind views:ChipBrushes.Text(Source)}"
                                                    Style="{StaticResource CaptionText}"
                                                    Text="{x:Bind Chip}" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Bind Recommendations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GuidanceRecommendation">
                                                    <!-- A hairline above each row, the first under the header -->
                                                    <Border
                                                        Padding="0,10,0,8"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        PointerEntered="OnRowEntered"
                                                        PointerExited="OnRowExited">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnSpacing="8" Visibility="{x:Bind LabelVisible}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Style="{StaticResource CaptionText}"
                                                                    Text="{x:Bind Number}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource MicroText}"
                                                                    Text="{x:Bind Tag}"
                                                                    Visibility="{x:Bind TagVisible}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    Style="{StaticResource MicroText}"
                                                                    Text="{x:Bind PageLabel}"
                                                                    Visibility="{x:Bind PageLabelVisible}" />
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    Style="{StaticResource MicroText}"
                                                                    Text="{x:Bind Path}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTipService.ToolTip="{x:Bind Path}"
                                                                    Visibility="{x:Bind PathVisible}" />
                                                            </Grid>
                                                            <!-- The recommendation as written, never trimmed -->
                                                            <TextBlock
                                                                IsTextSelectionEnabled="True"
                                                                Style="{StaticResource RecommendationText}"
                                                                Text="{x:Bind Text}" />
                                                            <TextBlock
                                                                Style="{StaticResource MicroText}"
                                                                Text="{x:Bind Matched}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{x:Bind Matched}"
                                                                Visibility="{x:Bind MatchedVisible}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <HyperlinkButton
                                                                    Padding="2,0"
                                                                    AutomationProperties.Name="{x:Bind ShowName}"
                                                                    Click="OnShowInDocument"
                                                                    FontSize="12"
                                                                    Visibility="{x:Bind ShowVisible}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon FontSize="12" Glyph="&#xE7C3;" />
                                                                        <TextBlock FontSize="12" Text="Show in document" />
                                                                    </StackPanel>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton
                                                                    Padding="2,0"
                                                                    AutomationProperties.Name="{x:Bind OpenName}"
                                                                    Click="OnOpen"
                                                                    FontSize="12"
                                                                    ToolTipService.ToolTip="{x:Bind views:GuidanceSectionView.Tip(OpenTip)}"
                                                                    Visibility="{x:Bind CanOpen}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                                                        <TextBlock FontSize="12" Text="Open" />
                                                                    </StackPanel>
                                                                </HyperlinkButton>
                                                                <HyperlinkButton
                                                                    Padding="2,0"
                                                                    AutomationProperties.Name="{x:Bind CopyName}"
                                                                    Click="OnCopyCitation"
                                                                    FontSize="12">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                                        <TextBlock FontSize="12" Text="Copy citation" />
                                                                    </StackPanel>
                                                                </HyperlinkButton>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
