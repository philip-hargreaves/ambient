<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.GuidanceSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Ambient.App.Core.ViewModels">

    <Grid RowSpacing="8" Visibility="{x:Bind ViewModel.Visible, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The fold the patient sheet uses in the review -->
        <Button
            Margin="-9,0,0,-2"
            Padding="9,4"
            HorizontalAlignment="Left"
            Click="OnFoldClick"
            Style="{StaticResource TrayButton}"
            ToolTipService.ToolTip="Show or hide the guidelines. They are matched to the note by similarity; a match can come from a neighbouring condition, and the clinician decides what applies.">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource DocumentHeadingText}" Text="Guidelines" />
                <FontIcon
                    x:Name="FoldGlyph"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource FaintTextBrush}"
                    Glyph="&#xE70E;" />
            </StackPanel>
        </Button>

        <Grid x:Name="Body" Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Enter submits from the handler; an accelerator would fire from the note -->
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <TextBox
                    MinWidth="220"
                    AutomationProperties.Name="Search guidance"
                    IsEnabled="{x:Bind ViewModel.QueryBoxEnabled, Mode=OneWay}"
                    KeyDown="OnQueryKeyDown"
                    PlaceholderText="Search the installed guidance"
                    Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{x:Bind ViewModel.SearchQueryCommand}" Content="Search" />
            </StackPanel>

            <!-- Optional lines stack; a collapsed grid row would keep its spacing -->
            <StackPanel Grid.Row="1" Spacing="6">
                <!-- A typed query stands in for the note's cards until Clear -->
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.QueryShown, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionText}"
                        Text="{x:Bind ViewModel.QueryHeader, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.QuerySearching, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.QuerySearching, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource MicroText}"
                        Text="{x:Bind ViewModel.QueryCaption, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.QueryCaptionVisible, Mode=OneWay}" />
                    <HyperlinkButton
                        Grid.Column="3"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ClearQueryCommand}"
                        Content="Clear"
                        FontSize="12" />
                </Grid>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.CaptionVisible, Mode=OneWay}">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.Searching, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Searching, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource MicroText}"
                        Text="{x:Bind ViewModel.StateCaption, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchNoteCommand}"
                        Content="Try again"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchNoteCommand}"
                        Content="Search"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.NotSearched, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind Shell.ShowSettingsCommand}"
                        Content="Open Settings"
                        FontSize="12"
                        Visibility="{x:Bind ViewModel.NoCorpora, Mode=OneWay}" />
                </StackPanel>
                <!-- The stale row the patient sheet uses -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.SearchAgainVisible, Mode=OneWay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource CautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Foreground="{ThemeResource CautionBrush}"
                        Style="{StaticResource MicroText}"
                        Text="This guidance was found before your note edits." />
                    <HyperlinkButton
                        Padding="2,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchNoteCommand}"
                        FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            <TextBlock FontSize="12" Text="Search again" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource CautionBrush}"
                    Style="{StaticResource MicroText}"
                    Text="Not saved with this consultation - see the status bar"
                    Visibility="{x:Bind ViewModel.NotStored, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.CardsVisible, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuidanceCard">
                            <Border
                                Margin="0,0,0,6"
                                Padding="12"
                                Style="{StaticResource InnerCardSurface}">
                                <StackPanel Spacing="3">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Reference}" />
                                            <TextBlock
                                                Style="{StaticResource MicroText}"
                                                Text="{x:Bind Tag}"
                                                Visibility="{x:Bind TagVisible}" />
                                            <TextBlock
                                                Style="{StaticResource MicroText}"
                                                Text="{x:Bind LastUpdatedLabel}"
                                                Visibility="{x:Bind LastUpdatedVisible}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Style="{StaticResource ChipBorder}"
                                            Visibility="{x:Bind SourceLabelVisible}">
                                            <TextBlock
                                                Style="{StaticResource CaptionText}"
                                                Text="{x:Bind SourceLabel}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource MicroText}"
                                        Text="{x:Bind Context}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Context}" />
                                    <!-- The recommendation as written, never trimmed -->
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource BodyText}"
                                        Text="{x:Bind Text}" />
                                    <TextBlock
                                        Style="{StaticResource MicroText}"
                                        Text="{x:Bind Matched}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Trigger}"
                                        Visibility="{x:Bind MatchedVisible}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <HyperlinkButton
                                            Padding="2,0"
                                            AutomationProperties.Name="{x:Bind OpenName}"
                                            Click="OnOpen"
                                            FontSize="12"
                                            Visibility="{x:Bind CanOpen}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                                <TextBlock FontSize="12" Text="Open" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                        <HyperlinkButton
                                            Padding="2,0"
                                            AutomationProperties.Name="{x:Bind CopyName}"
                                            Click="OnCopyCitation"
                                            FontSize="12">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                <TextBlock FontSize="12" Text="Copy citation" />
                                            </StackPanel>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
