<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Ambient.App.Views.PageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Ambient.App.Views"
    xmlns:vm="using:Ambient.App.Core.ViewModels"
    AutomationProperties.LandmarkType="Custom"
    AutomationProperties.Name="Page view"
    KeyDown="OnKeyDown">

    <!-- A pane beside the note: the page stays white in both themes, since a
         clinician recognises the printed page and inverting it corrupts figures -->
    <Border Padding="16,12" Style="{StaticResource InnerCardSurface}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.DocumentName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DocumentName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource MicroText}" Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Style="{StaticResource TrayButton}"
                    ToolTipService.ToolTip="Previous page"
                    Visibility="{x:Bind ViewModel.Spans, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                </Button>
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Style="{StaticResource TrayButton}"
                    ToolTipService.ToolTip="Next page"
                    Visibility="{x:Bind ViewModel.Spans, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="3"
                    AutomationProperties.Name="Close the page view"
                    Command="{x:Bind ViewModel.CloseCommand}"
                    Style="{StaticResource TrayButton}"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <ScrollViewer
                        x:Name="Scroller"
                        Background="{ThemeResource PageSheetBrush}"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        MaxZoomFactor="4"
                        MinZoomFactor="1"
                        SizeChanged="OnScrollerSized"
                        Visibility="{x:Bind ViewModel.SheetVisible, Mode=OneWay}"
                        ZoomMode="Enabled">
                        <Viewbox x:Name="Sheet" Stretch="Uniform">
                            <!-- The page sits on a grey sheet with its own edge. The grid
                                 is the bitmap's size, so a mark is its line's fractions times
                                 that size and nothing else scales -->
                            <Border
                                Padding="24"
                                Background="{ThemeResource PageSheetBrush}">
                            <Border
                                BorderBrush="{ThemeResource PageEdgeBrush}"
                                BorderThickness="2">
                            <Grid
                                Width="{x:Bind ViewModel.Width, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Height, Mode=OneWay}"
                                Background="White">
                                <Image
                                    AutomationProperties.Name="{x:Bind ViewModel.ImageName, Mode=OneWay}"
                                    ImageOpened="OnPageOpened"
                                    Source="{x:Bind views:PageView.Bitmap(ViewModel.ImagePath), Mode=OneWay}"
                                    Stretch="Fill" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Boxes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PageBox">
                                            <!-- The canvas places each item's container at the
                                                 origin, so the offset rides on the margin -->
                                            <Rectangle
                                                Width="{x:Bind views:PageView.Grown(Width)}"
                                                Height="{x:Bind views:PageView.Grown(Height)}"
                                                Margin="{x:Bind views:PageView.Offset(Left, Top)}"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource PageMarkBrush}"
                                                RadiusX="3"
                                                RadiusY="3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            </Border>
                            </Border>
                        </Viewbox>
                    </ScrollViewer>
                    <!-- A blank sheet at the page's shape until the image and marks land together -->
                    <Viewbox
                        x:Name="Placeholder"
                        Stretch="Uniform"
                        Visibility="{x:Bind ViewModel.PlaceholderVisible, Mode=OneWay}">
                        <Border Padding="24" Background="{ThemeResource PageSheetBrush}">
                            <Grid
                                Width="{x:Bind ViewModel.Width, Mode=OneWay}"
                                Height="{x:Bind ViewModel.Height, Mode=OneWay}"
                                Background="White"
                                BorderBrush="{ThemeResource PageEdgeBrush}"
                                BorderThickness="2">
                                <ProgressRing
                                    Width="64"
                                    Height="64"
                                    IsActive="{x:Bind ViewModel.Loading, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </Viewbox>
                    <StackPanel
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Spacing="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionText}"
                            Text="Showing the page"
                            Visibility="{x:Bind ViewModel.Slow, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource CautionBrush}"
                            Style="{StaticResource CaptionText}"
                            Text="The page could not be shown."
                            Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.TryAgainCommand}"
                            Content="Try again"
                            FontSize="12"
                            Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <HyperlinkButton
                    Padding="2,0"
                    Command="{x:Bind ViewModel.OpenDocumentCommand}"
                    FontSize="12"
                    ToolTipService.ToolTip="Opens a copy in your PDF viewer. The copy is removed when Ambient closes.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                        <TextBlock FontSize="12" Text="Open the document" />
                    </StackPanel>
                </HyperlinkButton>
                <HyperlinkButton
                    Padding="2,0"
                    Command="{x:Bind ViewModel.CopyCitationCommand}"
                    FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                        <TextBlock FontSize="12" Text="Copy citation" />
                    </StackPanel>
                </HyperlinkButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
